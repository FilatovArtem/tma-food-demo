# Telegram Bot (from @BotFather → /newbot)
BOT_TOKEN=1234567890:AAAA-replace-with-real-token

# Owner chat for order notifications (your TG user id from @userinfobot)
ADMIN_CHAT_ID=123456789

# Mini App URL (must be HTTPS; via ngrok/cloudflared for dev)
# Set this in @BotFather → bot settings → Menu Button or Web App URL
WEBAPP_URL=https://your-tunnel-domain.ngrok-free.app

# OpenAI
OPENAI_API_KEY=sk-replace-with-real-key
OPENAI_MODEL=gpt-4o-mini

# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Frontend (build-time)
VITE_API_URL=/api
VITE_DEMO_MODE=false

# CORS (comma-separated origins, * for dev only)
CORS_ORIGINS=https://web.telegram.org,https://your-tunnel-domain.ngrok-free.app

# Init Data freshness window (seconds). 3600 = 1 hour (tma.js default, recommended).
# Set to 86400 (24h) if demo sessions span a day.
INIT_DATA_MAX_AGE=3600
